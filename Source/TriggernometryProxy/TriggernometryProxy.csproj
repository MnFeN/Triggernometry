<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Configuration>Release</Configuration>
		<Platform>AnyCPU</Platform>
		<ProjectGuid>{AA747357-8F4A-4633-A631-B421CA05BC26}</ProjectGuid>
		<OutputType>Library</OutputType>
		<AppDesignerFolder>Properties</AppDesignerFolder>
		<RootNamespace>TriggernometryProxy</RootNamespace>
		<AssemblyName>Triggernometry</AssemblyName>
		<TargetFramework>net481</TargetFramework>
		<FileAlignment>512</FileAlignment>
		<Deterministic>true</Deterministic>
		<NuGetPackageImportStamp>
		</NuGetPackageImportStamp>
		<TargetFrameworkProfile />
		<DebugType>pdbonly</DebugType>
		<Optimize>true</Optimize>
		<OutputPath>bin\Release\</OutputPath>
		<DefineConstants>TRACE</DefineConstants>
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
		<StartAction>Program</StartAction>
		<StartProgram>C:\Program Files (x86)\Advanced Combat Tracker\Advanced Combat Tracker.exe</StartProgram>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<SatelliteResourceLanguages>None</SatelliteResourceLanguages>
		<ReleasePublishDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\publish\'))</ReleasePublishDirectory>
		<PublishDir>$(ReleasePublishDirectory)</PublishDir>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="..\BuildVersion.cs" Link="Properties\BuildVersion.cs" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="Advanced Combat Tracker">
			<HintPath>..\..\lib\Advanced Combat Tracker.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="System" />
		<Reference Include="System.Core" />
		<Reference Include="System.Drawing" />
		<Reference Include="System.Windows.Forms" />
		<Reference Include="System.Xml.Linq" />
		<Reference Include="System.Data.DataSetExtensions" />
		<Reference Include="Microsoft.CSharp" />
		<Reference Include="System.Data" />
		<Reference Include="System.Xml" />
		<ProjectReference Include="..\Triggernometry\TriggernometryPlugin.csproj" />
		<!--下面是从TriggernometryPlugin复制的，Costura自动打包-->
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.9">
			<Private>True</Private>
		</PackageReference>
		<PackageReference Include="System.Collections.Immutable" Version="9.0.9">
			<Private>True</Private>
		</PackageReference>
		<PackageReference Include="System.Net.Http" Version="4.3.4" />
		<PackageReference Include="System.Reflection.Metadata" Version="9.0.9" />
		<PackageReference Include="System.Text.Json" Version="9.0.9">
			<Private>True</Private>
		</PackageReference>
		<PackageReference Include="System.ValueTuple" Version="4.6.1" />
		<Reference Include="System.Web.Extensions" />
	</ItemGroup>
	<ItemGroup>
		<None Include="FodyWeavers.xml" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Costura.Fody" Version="6.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>all</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<Target Name="SelectReleaseFiles" AfterTargets="ComputeFilesToPublish">
		<MSBuild Projects="..\Triggernometry\TriggernometryPlugin.csproj" Targets="GetTargetPath"
			Properties="Configuration=$(Configuration);Platform=$(Platform)">
			<Output TaskParameter="TargetOutputs" ItemName="_PluginPublishAssembly" />
		</MSBuild>
		<!-- 清单版本取自本次编译的 DLL，避免上传时遗漏更新版本号。 -->
		<GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
			<Output TaskParameter="Assemblies" ItemName="_ReleaseAssemblyIdentity" />
		</GetAssemblyIdentity>
		<!-- 清空发布目录前保留手动调整的最低允许版本。 -->
		<XmlPeek XmlInputPath="$(ReleasePublishDirectory)UpdateManifest.xml"
			Query="/UpdateManifest/@LowestAllowedVersion" Condition="Exists('$(ReleasePublishDirectory)UpdateManifest.xml')">
			<Output TaskParameter="Result" PropertyName="_LowestAllowedVersion" />
		</XmlPeek>
		<PropertyGroup>
			<_UpdateManifest>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\UpdateManifest.template.xml'))</_UpdateManifest>
			<_UpdateManifest>$(_UpdateManifest.Replace('Version=&quot;&quot;', 'Version=&quot;%(_ReleaseAssemblyIdentity.Version)&quot;'))</_UpdateManifest>
			<_UpdateManifest Condition="'$(_LowestAllowedVersion)' != ''">$([System.Text.RegularExpressions.Regex]::Replace($(_UpdateManifest), 'LowestAllowedVersion=&quot;[^&quot;]*&quot;', 'LowestAllowedVersion=&quot;$(_LowestAllowedVersion)&quot;'))</_UpdateManifest>
		</PropertyGroup>
		<WriteLinesToFile File="$(IntermediateOutputPath)UpdateManifest.xml"
			Lines="$([MSBuild]::Escape($(_UpdateManifest)))" Overwrite="true" Encoding="UTF-8" />
		<ItemGroup>
			<_ReleaseFiles Include="$(TargetPath);@(_PluginPublishAssembly)" />
			<_ReleaseFiles Include="$(MSBuildProjectDirectory)\..\..\Translations\zh-CN.triglations.xml" />
			<_ReleaseFiles Include="$(IntermediateOutputPath)UpdateManifest.xml" />
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" />
			<ResolvedFileToPublish Include="@(_ReleaseFiles)">
				<RelativePath>%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>Always</CopyToPublishDirectory>
			</ResolvedFileToPublish>
		</ItemGroup>
		<!-- This generated output directory must contain only the current release files. -->
		<RemoveDir Directories="$(ReleasePublishDirectory)" />
		<MakeDir Directories="$(ReleasePublishDirectory)" />
		<Message Importance="High" Text="Release files: @(ResolvedFileToPublish->'%(RelativePath)', ', ')" />
	</Target>
</Project>